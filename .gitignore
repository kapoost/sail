# Rust build artefacts
/target/

# The lockfile IS committed: this workspace will grow a binary (the presentation
# layer), and a reproducible build matters more than dependency freshness.

# macOS
.DS_Store

# Editors
.idea/
*.swp

# Packaged builds
/dist/out/
# The shop's screenshots: build output, taken by `dist/store.sh`, uploaded once.
/dist/store/
# The depot payloads and whatever SteamPipe leaves behind. A hundred and sixty megabytes
# of binary per platform, rebuilt from the tree by `dist/steam.sh` — the manifests beside
# them are source and are kept.
/dist/steam/content/
/dist/steam/output/
/dist/steam/*.generated.vdf

# Session scratch
/.claude/

# Generated hulls under evaluation: provenance and licence not settled, and they
# are an experiment rather than the boat. The knobs that load them are in boat.rs.
assets/*-hull.glb

# The built page. Generated from site/ by site/build.py and published by the pages
# workflow; checking it in would be checking in a copy of the key list, which is the
# one thing this arrangement exists to avoid.
/_site/
/.playwright-mcp/
__pycache__/
# Voice recordings are somebody's voice, not source. They live outside this tree and are
# pointed at with `SAIL_VOICE` — see `sound.rs` — so that a placeholder cut out of a
# public-domain reading cannot be shipped by forgetting about it.
/voice/
