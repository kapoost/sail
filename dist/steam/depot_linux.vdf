// The linux depot: everything under content/linux, flattened into the install directory.
//
// "LocalPath" is relative to the contentroot in app_build.vdf. The library beside the
// binary is not optional — see the note at the top of dist/steam.sh.
"DepotBuild"
{
	"DepotID"	"APPID3"
	"contentroot"	"../../dist/steam/content/linux"
	"FileMapping"
	{
		"LocalPath"	"*"
		"DepotPath"	"."
		"recursive"	"1"
	}
	"FileExclusion"	"*.pdb"
	"FileExclusion"	"*.dSYM"
}
